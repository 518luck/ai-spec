// # 项目域：项目（接入的代码仓库，AGENTS.md 的顶层容器）+ 项目内文件夹
//
// 结构对应前端 src/pages/spec/personal/projects：
//   项目卡片 → 文件夹树 / 配置卡片 → 配置阅读
// ! 项目内文件夹为树形表（parentId 自关联），每项目一条根文件夹记录；配置与文件夹多对多
//   关联（AgentsMdFolder 中间表，见 agents-md.prisma），不再有路径前缀推导

// 项目：AGENTS.md 的顶层容器，对应一个代码仓库
// 当前为用户手建；repoUrl 预留给将来的 git 仓库同步
model Project {
  // ① 主键
  id String @id @default(cuid())

  // ② 业务字段
  name        String // 项目名（如 "ai-spec"），亦是文件夹树根节点的显示名
  description String? // 项目简介，项目卡片的副标题
  repoUrl     String? @map("repo_url") // 仓库地址，null=纯手建；预留给将来的 git 同步
  folderId    String? @map("folder_id") // 所属分组文件夹（个人空间的跨项目分组，如"工作/个人/学习"）；null=未分类

  // ③ 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ④ 外键列
  ownerId String  @map("owner_id")
  teamId  String? @map("team_id") // null=个人项目，非 null=团队项目（与 RuleSpace 对称）

  // ⑤ 关联关系
  owner     User       @relation("AgentsProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade) // 创建者（删除用户→级联删其项目）
  team      Team?      @relation("TeamAgentsProjects", fields: [teamId], references: [id], onDelete: Cascade) // 所属团队（团队删除→级联删其项目；null=个人项目）
  folder    Folder?    @relation("FolderItems_Project", fields: [folderId], references: [id], onDelete: SetNull) // 所属分组文件夹（文件夹删除→项目保留，folderId 置空）
  agentsMds      AgentsMd[]      // 项目下的全部 AGENTS.md 配置（模型见 agents-md.prisma）
  projectFolders ProjectFolder[] // 项目下的文件夹树（模型见下文）

  // ⑥ 索引
  @@index([ownerId]) // 加速"我的项目"查询（首页项目卡片）
  @@index([teamId]) // 加速团队项目查询
  @@index([folderId]) // 加速按文件夹筛选项目
  @@schema("project")
}

// 项目内文件夹：树形结构（parentId 自关联），可独立于配置存在（纯归纳组织）
// 每项目一条根文件夹记录（parentId=null，name 与项目名一致）：顶层配置/文件夹都挂它下面，
// 文件树的第一行就是它（前端显示项目名）
// ! 只与项目挂钩（projectId），不记录创建者：文件夹是项目的子资源，删除用户时项目已级联删除
model ProjectFolder {
  // ① 主键
  id String @id @default(cuid())

  // ② 业务字段
  name     String  // 文件夹名（如 "app"）；根文件夹 name 与项目名一致
  parentId String? @map("parent_id") // 父文件夹 id；null = 项目根下

  // ③ 时间戳
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ④ 外键列
  projectId String @map("project_id")

  // ⑤ 关联关系
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade) // 所属项目（项目删除→级联删其下文件夹）
  parent    ProjectFolder?   @relation("ProjectFolderTree", fields: [parentId], references: [id], onDelete: Cascade) // 父文件夹（父删→级联删其子树）
  children  ProjectFolder[]  @relation("ProjectFolderTree") // 子文件夹
  agentsMds AgentsMdFolder[] // 挂载的 AGENTS.md 配置（多对多中间表，模型见 agents-md.prisma）

  // ⑥ 索引
  @@unique([projectId, parentId, name]) // 同层同名唯一（根文件夹层 parentId=null 亦生效）
  @@index([projectId]) // 加速"项目内全部文件夹"查询
  @@schema("project")
}
