NEXT_PUBLIC_APP_NAME="AI Spec"
BASE_URL="http://localhost:3000"

# 以下 prisma+postgres 形式的 URL 与通过 prisma dev 命令行运行本地 Prisma Postgres 服务器所生成的 URL 类似（在未选择任何非默认端口或设置的情况下）。与远程 Prisma Postgres URL 中的 API 密钥不同，此处的 API 密钥不包含任何敏感信息。
#   DATABASE_URL="postgresql://用户名:密码@主机:端口/数据库名?schema=public"
DATABASE_URL=""

# Axiom – 用于日志记录和监控
# https://axiom.co/docs/rest-api/authentication
AXIOM_TOKEN=""
AXIOM_DATASET="prompt"
IS_AXIOM_ENABLED="false"

# 限流
REDIS_URL=""

# resend 邮件发送
# 邮件发送 provider：resend（生产，默认）| mailpit（本地开发捕获）
EMAIL_PROVIDER="mailpit"
# Resend email（EMAIL_PROVIDER=resend 时需要）
RESEND_API_KEY=""
# 本地 Mailpit SMTP（EMAIL_PROVIDER=mailpit 时生效）
SMTP_HOST="localhost"
SMTP_PORT="1026"

# NextAuth 签名密钥
AUTH_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# GitHub API 令牌：配后广场抓取限额 60→5000 次/时
GITHUB_TOKEN=

# S3 兼容对象存储（本地 MinIO）
# 自定义服务地址，MinIO 默认端口 9000
S3_ENDPOINT="http://localhost:9000"
# 数据中心区域，MinIO 不关心，保持 auto
S3_REGION="auto"
# 访问密钥 ID，MinIO 默认 minioadmin
S3_ACCESS_KEY_ID=""
# 访问密钥，MinIO 默认 minioadmin
S3_SECRET_ACCESS_KEY=""
# 公开存储桶名（需在 MinIO 控制台手动创建）
S3_PUBLIC_BUCKET="ai-spec-public"
# 私有存储桶名（需在 MinIO 控制台手动创建）
S3_PRIVATE_BUCKET="ai-spec-private"
# 公开访问基址，拼接文件 URL 用（endpoint + 桶名）
S3_PUBLIC_URL="http://localhost:9000/ai-spec-public"


# 广场 description 翻译：腾讯云机器翻译 TMT（TextTranslate）
# 控制台开通机器翻译 + 云 API 密钥：https://console.cloud.tencent.com/cam/capi
# 付费关闭，只用每月 500 万字符免费额度
TENCENT_SECRET_ID="" # 云 API 密钥 ID（必填）
TENCENT_SECRET_KEY="" # 云 API 密钥 Key（必填）
TENCENT_TMT_REGION="" # TMT 地域，默认 ap-guangzhou
TENCENT_TMT_PROJECT_ID="" # 腾讯云项目 ID，默认 0
TENCENT_TMT_CONCURRENCY="" # Bottleneck maxConcurrent，默认 2
TENCENT_TMT_MIN_INTERVAL_MS="" # Bottleneck minTime，默认 220（约 4.5 QPS）
TENCENT_TMT_RESERVOIR="" # 每秒令牌数，默认 5（对齐 TMT frequency limit）
TRANSLATION_BATCH_LIMIT="" # 单批最多取多少条待译，默认 100
TRANSLATION_CHUNK_SIZE="" # 每块送翻译的条数，默认 40
TRANSLATION_CONCURRENCY="" # translation worker 并发，默认 1
TRANSLATION_AUTO_CHAIN="" # 本批后是否自动续跑，默认 true；设 false 关闭

# 定时任务
TRANSLATION_BATCH_CRON="off" # 定时补译 cron（UTC），默认每天 05:00；设 off 关闭（开发时省钱）
DISCOVER_SCAN_CRON="off"  # 广场扫描 cron（UTC）；留空走默认每天 04:00；设 off 关闭定时
# DISCOVER_SCAN_CRON="0 4 * * *"
# TRANSLATION_BATCH_CRON="0 5 * * *"